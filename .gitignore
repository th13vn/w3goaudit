.env
.DS_Store
.vscode/
.agent/
.cursor/
.idea/
.claude/
.superpowers/
/w3goaudit
/report/
/security/
/web/
__pycache__/

# scripts/ holds dev-only tooling (benchmark harness, template forge, helpers)
# and is not published. Benchmark-dependent Go tests skip when it is absent.
/scripts/

# Benchmark runs are generated host artifacts. Keep only the directory marker;
# default and named runs must never be tracked.
benchmarks/results/*
!benchmarks/results/.gitkeep

# Private template lanes. Never publish these local rules or fixtures:
# candidates/ holds generic detectors under evaluation, incidents/ holds
# protocol-named rules derived from one real exploit each.
templates/candidates/
test-data/candidates/
templates/incidents/
test-data/incidents/
